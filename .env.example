# ==============================================================================
# ThinkFlow AI - Environment Configuration
# ==============================================================================

# Server Configuration
PROJECT_NAME="ThinkFlow AI"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Configuration
# SQLite (Local Dev Default):
DATABASE_URL=sqlite+aiosqlite:///./thinkflow.db
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thinkflow_ai

# Vector Database / Embeddings
VECTOR_DATABASE_URL=sqlite+aiosqlite:///./thinkflow.db

# AI Provider Configuration
# Options: "simulation" (Zero-cost demo/offline), "openai", "gemini", "anthropic"
AI_PROVIDER=simulation

# AI Provider API Keys (Uncomment and populate when using real providers)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-pro

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Document Uploads
UPLOAD_DIR=./app/uploads
MAX_UPLOAD_SIZE_MB=10
